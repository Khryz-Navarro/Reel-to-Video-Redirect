{
  "manifest_version": 3,
  "name": "Reel to Video Redirect",
  "version": "2.0.0",
  "description": "Opens Facebook reels in the regular video player (/watch). Toggle on or off from the toolbar.",
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": [
    "*://www.facebook.com/*",
    "*://facebook.com/*"
  ],
  "icons": { "16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png" },
  "action": {
    "default_title": "Reel to Video Redirect",
    "default_popup": "popup.html",
    "default_icon": { "16": "assets/icon16.png", "48": "assets/icon48.png" }
  },
  "background": { "service_worker": "background.js" },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "reel_redirect", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://www.facebook.com/*", "*://facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
